# Lokal saja. tools/setup-docker.ps1 membuat password acak di .env.
# Gunakan karakter URL-safe karena dipakai pada URL PostgreSQL.
POSTGRES_PASSWORD=ganti_dengan_password_acak_yang_panjang
WEB_PORT=3000
# Opsional: OAuth client ID bertipe Web application dari Google Cloud.
# Login Google tetap nonaktif jika kosong. Tidak memerlukan client secret untuk GIS popup.
GOOGLE_CLIENT_ID=
# Checkout hosted Midtrans. Default ditutup; gunakan sandbox saat pengembangan.
# Jangan masukkan key ke repository. Client key tidak dibutuhkan untuk mode redirect.
PAYMENTS_ENABLED=false
PUBLIC_APP_URL=http://localhost:3000
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Opsional: simpan key per lingkungan agar transaksi lama tetap bisa diverifikasi.
MIDTRANS_SANDBOX_SERVER_KEY=
MIDTRANS_PRODUCTION_SERVER_KEY=
# Saat HTTPS di VPS: COOKIE_SECURE=1 dan ALLOWED_ORIGINS=https://domain-anda
# ALLOWED_ORIGINS=
COOKIE_SECURE=0
